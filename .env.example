# --- S3 connections: S3_<n>_* for n = 1, 2, … (gaps are fine; n fixes the order) ---
# Each connection is one endpoint and one set of credentials. What the credentials may do is
# detected per bucket and folder; actions they may not do are greyed out.
#
# The development RustFS (npm run dev:s3), as the admin:
S3_1_NAME=Local RustFS
S3_1_ENDPOINT=http://127.0.0.1:9400       # unset = AWS S3
S3_1_ACCESS_KEY_ID=objectlens
S3_1_SECRET_ACCESS_KEY=objectlens-secret
# S3_1_REGION=us-east-1                   # AWS: the region of most buckets (others are followed)
# S3_1_SESSION_TOKEN=                     # temporary credentials
# S3_1_PROFILE=dev                        # AWS: a profile of ~/.aws/config (SSO etc.) instead of keys
# S3_1_ID=local                           # stable id in URLs (default: n)
# S3_1_FORCE_PATH_STYLE=true              # default: true with an ENDPOINT, false for AWS
# S3_1_TLS_REJECT_UNAUTHORIZED=true       # false = accept self-signed certificates
# S3_1_BUCKETS=photos,backups             # shown when ListBuckets is denied (and added to the list otherwise)
# S3_1_LIST_BUCKETS=true                  # false = only the BUCKETS above
# S3_1_READ_ONLY=false                    # true = never write through this connection
# S3_1_PROBE=true                         # side-effect-free write/delete/tag probes (see DECISIONS.md)
# S3_1_SHARE_LINKS=true                   # presigned download links
# S3_1_PUBLIC_ENDPOINT=https://s3.example.com  # host in share links, when browsers reach S3 under another name
# S3_1_KOPIA_PASSWORD=change-me           # kopia repositories on this connection (read-only browsing); else typed in the UI
# S3_1_KOPIA_PASSWORD_FILE=/run/secrets/kopia  # the same, from a file
# S3_1_VELERO_PASSWORD=change-me          # Velero's kopia repositories (secret velero-repo-credentials); else Velero's default, then the UI
# S3_1_VELERO_PASSWORD_FILE=/run/secrets/velero  # the same, from a file
#
# The same server as the read-only user of dev/s3-init.sh: everything that writes is greyed out.
# S3_2_NAME=Local RustFS (reader)
# S3_2_ENDPOINT=http://127.0.0.1:9400
# S3_2_ACCESS_KEY_ID=reader
# S3_2_SECRET_ACCESS_KEY=reader-secret
#
# AWS with the default credential chain (environment, ~/.aws, SSO, instance role):
# S3_3_NAME=AWS
# S3_3_REGION=eu-north-1

# --- HTTP ---
# ObjectLens has no login: anyone who can reach it can use its credentials. Keep it on loopback.
# LISTEN_HOST=127.0.0.1
# PORT=3000
# ALLOWED_HOSTS=lens.localhost            # extra Host names to accept (DNS rebinding guard)

# --- Limits ---
# BULK_LIMIT=10000                        # objects per copy/move/delete request (the UI continues until done)
# SEARCH_SCAN_LIMIT=100000                # keys a search or size count looks at
# TEXT_EDIT_MAX_BYTES=2097152             # largest file previewed and edited as text
# SHARE_MAX_HOURS=168                     # longest share link (SigV4 allows 7 days)
# CAPABILITY_TTL_MINUTES=10               # how long probe results and learned denials are kept

# --- kopia (read-only backup browsing) ---
# KOPIA_BIN=kopia                         # the kopia CLI (the container image includes it)
# KOPIA_DIR=/var/lib/objectlens/kopia    # kopia's configuration (holds the S3 keys) and cache; default ~/.cache/objectlens/kopia

# --- Development ---
# docker compose publishes RustFS on CONTAINER_HOST_ADDRESS (default 127.0.0.1), port DEV_S3_PORT (9400).
# DEV_S3_PORT=9400
# Integration tests (npm test) against the development RustFS; unset to skip them
# TEST_S3_ENDPOINT=http://127.0.0.1:9400
# TEST_KOPIA_BIN=build/kopia/kopia        # kopia tests; default: build/kopia/kopia (npm run kopia:bin), else kopia on the PATH
